# MoveWell POC backend env
# If MONGODB_URI is missing/empty (or connection fails), the server falls back
# to an offline JSON-file store at ./data/db.json. No real secrets are committed.
MONGODB_URI=mongodb://localhost:27017
ADMIN_EMAIL=doctor@movewell.physio
ADMIN_PASSWORD=demo1234
SESSION_SECRET=change-me-in-production
PORT=5000
# Used only in production for CORS. In dev any http://localhost:<port> or
# http://127.0.0.1:<port> origin is reflected with credentials enabled.
FRONTEND_URL=http://localhost:3003
